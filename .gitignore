# ============================================================
# VitalStream: files Git should never track
# (one file for the whole project: backend, dashboard, docs)
# ============================================================

# ---- Documentation exports, screenshots, notes ----
docs/

# ---- Old code kept only for comparison while rebuilding ----
_reference/

# ---- Secrets and local settings ----
# Real settings stay on your machine; the *.example files are shared.
.env
.env.*
!.env.example
_reference

# ---- Python (backend) ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Node / React (dashboard) ----
node_modules/
dashboard/dist/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Logs ----
*.log
logs/

# ---- Editors and IDEs ----
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- Operating system junk ----
.DS_Store
Thumbs.db
desktop.ini
